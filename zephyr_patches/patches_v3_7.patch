+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifdef CONFIG_I3C_NPCX_DMA
+
+/**
+ * @brief Configures the application's buffer for use in MDMA mode.
+ *
+ * @param dev Pointer to the device structure for the driver instance.
